#:import dp kivy.metrics.dp
#:import get_color_from_hex kivy.utils.get_color_from_hex
#:import colors kivymd.color_definitions.colors

<CallScreen>

    MDFloatLayout:

        canvas.before:
            Color:
                rgba: 0, 0, 0, 1

            Rectangle:
                pos: self.pos
                size: self.size

        FitImage:
            id: title_image
            source: "/Users/vordenby/Documents/IDEs-VSTU/Practice-10/CallScreen/uix/screens/kv/callscreen.kv"
            size_hint_y: .45

        MDTopAppBar:
            title: "Profile"
            elevation: 0
            pos_hint: {"top": 1}

            left_action_items:
                [["menu", lambda x: x]]

            right_action_items:
                [["dots-vertical", lambda x: x]]

        MDFloatLayout:
            id: round_avatar

            size_hint: None, None
            size: "110dp", "110dp"

            md_bg_color: 1, 1, 1, 1

            radius:
                [self.height / 2]

            pos_hint:
                {"center_x": .5}

            y:
                root.height * .45 - self.height / 2

            FitImage:
                source: "/Users/vordenby/Documents/IDEs-VSTU/Practice-10/CallScreen/data/images/round-avatar.jpg"

                size_hint: None, None
                size: "100dp", "100dp"

                radius:
                    [self.height / 2]

                pos_hint:
                    {"center_x": .5, "center_y": .5}

        MDLabel:
            id: user_name

            text: "Irene"

            adaptive_size: True

            pos_hint:
                {"center_x": .5}

            y:
                round_avatar.y - dp(60)

            halign: "center"

            theme_text_color: "Custom"
            text_color: 1, 1, 1, 1

            font_style: "H4"

            bold: True

        MDList:
            id: list_box

            pos_hint:
                {"center_x": .5}

            size_hint: .9, None

            height:
                self.minimum_height

            y:
                root.height * .18

            opacity: 1

            spacing:
                dp(10)

            OneLineAvatarIconListItem:

                text: "Phone"

                IconLeftWidget:
                    icon: "phone"

                IconRightWidget:
                    icon: "chevron-right"

            OneLineAvatarIconListItem:

                text: "Email"

                IconLeftWidget:
                    icon: "email"

                IconRightWidget:
                    icon: "chevron-right"

            OneLineAvatarIconListItem:

                text: "Address"

                IconLeftWidget:
                    icon: "map-marker"

                IconRightWidget:
                    icon: "chevron-right"

        MDFloatLayout:
            id: call_box

            size_hint: .9, None
            height: "80dp"

            pos_hint:
                {"center_x": .5}

            y:
                -self.height

            opacity: 0

            md_bg_color:
                .15, .15, .15, 1

            radius:
                [25]

            MDBoxLayout:

                spacing:
                    dp(20)

                padding:
                    dp(20)

                pos_hint:
                    {"center_y": .5}

                MDIconButton:
                    icon: "microphone"

                MDIconButton:
                    icon: "video"

                MDIconButton:
                    icon: "volume-high"

                MDIconButton:
                    icon: "message"

        MDFloatingActionButton:
            icon: "phone"

            md_bg_color:
                get_color_from_hex(colors["Green"]["A700"])

            pos_hint:
                {"center_x": .9}

            y:
                root.height * .45 - self.height / 2

            on_release:
                root.animation_title_image(title_image)
                root.animation_blur_value()
                root.animation_call_button(self)
                root.animation_list_box(list_box)
                root.animation_round_avatar(round_avatar, user_name)
                root.animation_user_name(round_avatar, user_name)
                root.animation_call_box(call_box, user_name)
                root.open_call_box = not root.open_call_box