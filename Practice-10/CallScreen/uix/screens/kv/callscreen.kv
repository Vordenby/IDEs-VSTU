#:import dp kivy.metrics.dp

<ActionTile@MDBoxLayout>:
    icon: ""
    text: ""
    orientation: "vertical"
    size_hint: None, None
    size: dp(96), dp(116)
    spacing: dp(8)
    padding: 0
    pos_hint: {"center_x": .5, "center_y": .5}

    MDIconButton:
        icon: root.icon
        pos_hint: {"center_x": .5}
        theme_text_color: "Custom"
        text_color: 1, 1, 1, 1

    MDLabel:
        text: root.text
        halign: "center"
        adaptive_height: True
        theme_text_color: "Custom"
        text_color: 1, 1, 1, 1


<CallButton@MDFloatingActionButton>:
    elevation: 0
    md_bg_color: 0, .85, .32, 1
    icon_color: 1, 1, 1, 1


<CallScreen>:
    md_bg_color: 0, 0, 0, 1

    MDBoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            title: "Profile"
            elevation: 0
            md_bg_color: .05, .05, .05, 1
            specific_text_color: 1, 1, 1, 1
            left_action_items: [["menu", lambda x: None]]
            right_action_items: [["dots-vertical", lambda x: None]]

        MDRelativeLayout:

            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                spacing: dp(18)
                pos_hint: {"center_x": .5}
                y: root.height * .38

                MDCard:
                    size_hint: None, None
                    size: dp(120), dp(120)
                    radius: [dp(60)]
                    elevation: 0
                    md_bg_color: .12, .12, .12, 1
                    pos_hint: {"center_x": .5}

                    MDIcon:
                        icon: "account"
                        size_hint: None, None
                        size: dp(72), dp(72)
                        pos_hint: {"center_x": .5, "center_y": .5}
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1

                MDLabel:
                    text: "Denis Krilatkov"
                    adaptive_height: True
                    halign: "center"
                    bold: True
                    font_style: "H3"
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 1

            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                spacing: dp(16)
                padding: dp(0), dp(0), dp(0), dp(20)
                size_hint_x: .88
                pos_hint: {"center_x": .5}
                y: root.height * .06
                opacity: 1 if not root.open_call_box else 0

                MDCard:
                    size_hint_y: None
                    height: dp(74)
                    radius: [22]
                    elevation: 0
                    md_bg_color: .10, .10, .10, .95
                    padding: dp(20), 0

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(18)

                        MDIcon:
                            icon: "phone"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1
                            font_size: "26sp"
                            size_hint_x: None
                            width: dp(36)

                        MDBoxLayout:
                            orientation: "vertical"
                            spacing: dp(-2)

                            MDLabel:
                                text: "Phone"
                                bold: True
                                font_style: "Subtitle1"
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1

                            MDLabel:
                                text: "+7 (999) 777-11-00"
                                font_style: "Caption"
                                theme_text_color: "Custom"
                                text_color: .75, .75, .75, 1

                MDCard:
                    size_hint_y: None
                    height: dp(74)
                    radius: [22]
                    elevation: 0
                    md_bg_color: .10, .10, .10, .95
                    padding: dp(20), 0

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(18)

                        MDIcon:
                            icon: "email"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1
                            font_size: "26sp"
                            size_hint_x: None
                            width: dp(36)

                        MDBoxLayout:
                            orientation: "vertical"
                            spacing: dp(-2)

                            MDLabel:
                                text: "Email"
                                bold: True
                                font_style: "Subtitle1"
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1

                            MDLabel:
                                text: "krilatkov.denis@gmail.com"
                                font_style: "Caption"
                                theme_text_color: "Custom"
                                text_color: .75, .75, .75, 1

            CallButton:
                icon: "phone"
                pos_hint: {"center_x": .90, "center_y": .50}
                on_release: root.toggle_call()

            MDCard:
                id: call_box
                orientation: "vertical"
                size_hint: .86, None
                height: dp(400)
                pos_hint: {"center_x": .5}
                y: root.call_box_y

                radius: [28]
                elevation: 0
                md_bg_color: .08, .08, .08, 1
                padding: dp(24)
                spacing: dp(18)

                MDLabel:
                    text: "Denis Krilatkov"
                    adaptive_height: True
                    halign: "center"
                    bold: True
                    font_style: "H3"
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 1

                MDGridLayout:
                    cols: 3
                    rows: 2
                    spacing: dp(14)
                    padding: 0
                    size_hint_x: 1
                    size_hint_y: None
                    height: dp(250)
                    col_default_width: dp(96)
                    row_default_height: dp(116)
                    col_force_default: True
                    row_force_default: True
                    pos_hint: {"center_x": .5}

                    ActionTile:
                        icon: "microphone-off"
                        text: "Mute"

                    ActionTile:
                        icon: "volume-high"
                        text: "Speaker"

                    ActionTile:
                        icon: "dialpad"
                        text: "Keypad"

                    ActionTile:
                        icon: "plus"
                        text: "Add"

                    ActionTile:
                        icon: "swap-horizontal"
                        text: "Transfer"

                    ActionTile:
                        icon: "account"
                        text: "Contact"

                MDFloatingActionButton:
                    icon: "phone-hangup"
                    md_bg_color: 1, 0, 0, 1
                    pos_hint: {"center_x": .5}
                    on_release: root.toggle_call()