#:import dp kivy.metrics.dp
#:import get_color_from_hex kivy.utils.get_color_from_hex
#:import colors kivymd.color_definitions.colors

#:import EffectWidget kivy.uix.effectwidget.EffectWidget
#:import HorizontalBlurEffect kivy.uix.effectwidget.HorizontalBlurEffect
#:import VerticalBlurEffect kivy.uix.effectwidget.VerticalBlurEffect

#:import FitImage kivymd.uix.fitimage.FitImage

#:import IconLeftWidget kivymd.uix.list.IconLeftWidget
#:import STANDARD_INCREMENT kivymd.material_resources.STANDARD_INCREMENT


<CallScreen>:
    # -------------------------------------------------------------
    EffectWidget:
        size_hint: 1, None
        height: root.height
        pos: root.pos
        effects: [ HorizontalBlurEffect(size=root.blur_value), VerticalBlurEffect(size=root.blur_value) ]

        FitImage:
            id: title_image
            source: "data/images/avatar.jpg"
            size_hint_y: .45          # 45 % от высоты экрана
            y: root.height - self.height

    # -------------------------------------------------------------
    MDToolbar:
        pos_hint: {"top": 1}
        md_bg_color: 0, 0, 0, 0   # прозрачный фон – виден фоновое фото
        opposite_colors: True
        title: "Profile"
        left_action_items: [["menu", lambda x: None]]
        right_action_items: [["dots-vertical", lambda x: None]]

    # -------------------------------------------------------------
    MDFloatLayout:
        id: round_avatar
        size_hint: None, None
        size: dp(105), dp(105)
        pos_hint: {"center_x": .5}
        y: root.height * 45 / 100 + self.height
        x: root.center_x - (self.width + user_name.width + dp(20)) / 2

        FitImage:
            id: avatar_image
            source: "data/images/round-avatar.jpg"
            size_hint: None, None
            size: dp(100), dp(100)
            mipmap: True
            radius: [self.height / 2]
            pos_hint: {"center_x": .5, "center_y": .5}

        MDLabel:
            id: user_name
            text: "Irene"
            font_style: "H3"
            bold: True
            size_hint: None, None
            size: self.texture_size
            theme_text_color: "Custom"
            text_color: 1, 1, 1, 1
            y: round_avatar.y + self.height / 2
            x: round_avatar.x + round_avatar.width + dp(20)

    # -------------------------------------------------------------
    MDBoxLayout:
        id: list_box
        orientation: "vertical"
        size_hint_y: None
        height: self.minimum_height
        pos_hint: {"center_x": .5}
        y: root.height * 45 / 100 - self.height / 2

        ItemList:
            icon: "phone"
            text: "Phone"
            secondary_text: "123 456 789"

        ItemList:
            icon: "mail"
            text: "Email"
            secondary_text: "kivydevelopment@gmail.com"

    # -------------------------------------------------------------
    MDFloatingActionButton:
        id: call_fab
        icon: "phone"
        md_bg_color: get_color_from_hex(colors["Green"]["A700"])
        x: root.width - self.width - dp(20)
        y: Window.height * 45 / 100 + self.height / 2

        on_release:
            root.animation_title_image(title_image)
            root.animation_blur_value()
            root.animation_call_button(self)
            root.animation_list_box(list_box)
            root.animation_round_avatar(round_avatar, user_name)
            root.animation_user_name(round_avatar, user_name)
            root.animation_call_box(call_box, user_name)
            root.open_call_box = not root.open_call_box

    # -------------------------------------------------------------
    CallBox:
        id: call_box
        pos_hint: {"center_x": .5}
        y: -self.height
        opacity: 0


# ==============================================================

<ItemList@TwoLineAvatarListItem>:
    icon: ""
    font_style: "Caption"
    secondary_font_style: "Caption"
    height: STANDARD_INCREMENT

    IconLeftWidget:
        icon: root.icon

<CallBoxButton@MDBoxLayout>:
    orientation: "vertical"
    adaptive_size: True
    spacing: dp(8)
    icon: ""
    text: ""

    MDIconButton:
        icon: root.icon
        theme_text_color: "Custom"
        text_color: 1, 1, 1, 1

        canvas:
            Color:
                rgba: 1, 1, 1, 1
            Line:
                width: 1
                circle: (self.center_x, self.center_y, min(self.width, self.height) / 2, 0, 360)

    MDLabel:
        text: root.text
        size_hint_y: None
        height: self.texture_size[1]
        font_style: "Caption"
        halign: "center"
        theme_text_color: "Custom"
        text_color: 1, 1, 1, 1

<CallBox@MDGridLayout>:
    cols: 3
    rows: 2
    adaptive_size: True
    spacing: dp(24)

    CallBoxButton:
        icon: "microphone-off"
        text: "Mute"

    CallBoxButton:
        icon: "volume-high"
        text: "Speaker"

    CallBoxButton:
        icon: "dialpad"
        text: "Keypad"

    CallBoxButton:
        icon: "plus-circle"
        text: "Add call"

    CallBoxButton:
        icon: "call-missed"
        text: "Transfer"

    CallBoxButton:
        icon: "account"
        text: "Contact"
